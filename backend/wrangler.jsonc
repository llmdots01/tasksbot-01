{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasksbot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Check for due reminders every minute.
  "triggers": { "crons": ["* * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tasksbot-db",
      // Created in the tasksbot01 Cloudflare account.
      "database_id": "2b561463-a636-4dac-827a-e72de8015fa2",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI, used for the free Llama model in the assistant.
  "ai": { "binding": "AI" },

  // Non-secret configuration. Secrets are set with `wrangler secret put` (see README).
  "vars": {
    "FRONTEND_URL": "https://aitask.pareops.in",
    "EXTRA_ORIGINS": "https://tasksbot.pages.dev",
    "API_URL": "https://tasksbot-api.tasksbot01.workers.dev",
    "EMAIL_FROM": "\"Task(AI)Do\" <reminders@aitest.pareops.in>",
    // AI assistant: Gemini is tried first (needs the GEMINI_API_KEY secret); Llama on Workers AI is the free fallback.
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_THINKING": "minimal",
    "LLAMA_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "ASSISTANT_DAILY_LIMIT": "200"
  }
}
